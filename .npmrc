fund=false
audit=false
# npm postinstall scripts: the DevEnv (DeepSeek Harness etc.) sets
# NPM_CONFIG_ALLOW_SCRIPTS=opencode-ai by default. Electron + electron-builder
# need postinstall scripts to fetch the native helper, so before installing
# run one of:
#
#   env -u NPM_CONFIG_ALLOW_SCRIPTS npm install    # uses allowlist in this .npmrc via the env var path
#   npm install --allow-scripts                    # if npm version accepts the override
#
# Most users: just run `npm install` and Electron will warn about its own
# scripts without blocking the install. Run again with the env override if
# you see EALLOWSCRIPTS errors.
